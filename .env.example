# Mongo connection string. In docker-compose this becomes mongodb://mongo:27017/yelpcamp
DB_URL=mongodb://localhost:27017/yelpcamp

# Redis connection string used for caching campground/query embeddings. In docker-compose this becomes redis://redis:6379
REDIS_URL=redis://localhost:6379

# Express session signing secret
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: overrides the default local embedding model (Xenova/all-mpnet-base-v2)
EMBEDDING_MODEL=Xenova/all-mpnet-base-v2

# Mapbox geocoding token, used when creating a campground
MAPBOX_TOKEN=

# Cloudinary credentials, used for campground image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
